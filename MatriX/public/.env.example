# ────────────────────────────────────────────────────────────
# alert_engine.py / monthly_report.py — variables de entorno
# Copia este fichero a .env y rellena los valores.
# NUNCA subas el .env real al repositorio.
# ────────────────────────────────────────────────────────────

# API key de Resend (https://resend.com). Obligatoria para ambos scripts.
RESEND_API_KEY=re_tu_api_key_aqui

# ─── alert_engine.py ────────────────────────────────────────
# Remitente verificado en Resend. Opcional.
# Por defecto: alertas@matriculaciones.es
ALERT_SENDER=alertas@matriculaciones.es

# Rutas opcionales. Por defecto, todos en el mismo directorio que alert_engine.py.
# ALERT_SUBS=./subscribers.json
# ALERT_CSV=./df_real_pred_mensual_total.csv
# ALERT_LOG=./alert_log.txt

# ─── monthly_report.py ──────────────────────────────────────
# Remitente verificado en Resend para el informe mensual. Opcional.
# Por defecto: informes@matriculaciones.es
REPORT_SENDER=informes@matriculaciones.es

# URL pública del dashboard incluida en el pie del email. Opcional.
# Por defecto: http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# Rutas opcionales para monthly_report.py.
# REPORT_SUBS=./subscribers.json
# REPORT_LOG=./monthly_report_log.txt
