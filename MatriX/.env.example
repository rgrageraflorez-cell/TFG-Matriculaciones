# ────────────────────────────────────────────────────────────────────
# MatriX — Variables de entorno
#
# Copia este archivo a `.env` (o `.env.local`) y rellena los valores.
# Nunca subas el `.env` real al repositorio: solo `.env.example`.
# ────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ─────────────────────────────────────────────────
# URL pública del CSV pesado df_mensual_marca_lugar.csv (~150 MB).
# Alojado en Google Drive porque supera el límite de 100 MB de GitHub.
# Formato: https://drive.google.com/uc?export=download&id=TU_ID_AQUI
VITE_CSV_MARCA_LUGAR_URL=https://drive.google.com/uc?export=download&id=TU_ID_AQUI

# Clave API de Gemini (asistente IA del dashboard).
# Solo necesaria si se utilizan funciones de generación con IA.
GEMINI_API_KEY=tu_clave_gemini_aqui

# ── Backend Python (alert_engine.py / monthly_report.py) ────────────
# Clave API de Resend para el sistema de alertas y el informe mensual.
RESEND_API_KEY=tu_clave_resend_aqui

# Remitente verificado en Resend (debe coincidir con un dominio verificado).
ALERT_SENDER=alertas@tu-dominio.com
REPORT_SENDER=informes@tu-dominio.com

# Email destinatario para pruebas manuales del motor de alertas.
ALERT_EMAIL_TO=tu_email@ejemplo.com

# URL del dashboard (usada en los enlaces incrustados en los emails).
DASHBOARD_URL=http://localhost:5173

# ── Vercel Blob (persistencia de suscriptores) ──────────────────────
# Token de escritura del store de Blob. Lo inyecta automaticamente la
# integracion Blob de Vercel cuando vinculas el almacen al proyecto;
# añadirlo a mano solo es necesario en GitHub Actions.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# URL base publica del store de Blob.
# Formato: https://<store-id>.public.blob.vercel-storage.com
BLOB_BASE_URL=https://tustoreid.public.blob.vercel-storage.com

# Secret usado para obfuscar el pathname del blob de suscriptores.
# El pathname final es subscribers/<sha256(SUBSCRIBERS_SECRET + "v1")>.json
# La privacidad se basa en que la URL no es enumerable; rotar este
# valor regenera el pathname (los suscriptores antiguos quedan
# huerfanos hasta migrarlos).
SUBSCRIBERS_SECRET=cadena_aleatoria_larga_min_32_chars
